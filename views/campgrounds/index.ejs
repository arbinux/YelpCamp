<% layout('layouts/boilerplate') %>

<!-- =========================
     CLUSTER MAP
========================= -->

<div
    id="map"
    style="width: 100%; height: 500px;"
></div>


<!-- =========================
     CAMPGROUNDS
========================= -->

<h1 class="mt-5">
    All Campgrounds
</h1>

<div class="mb-3">
    <a
        href="/campgrounds/new"
        class="btn btn-success"
    >
        Add New Campground
    </a>
</div>


<% for (let camp of campgrounds) { %>

    <div class="card mb-3 shadow-sm">

        <div class="row g-0">

            <!-- IMAGE -->

            <div class="col-md-4">

                <img
                    src="<%= camp.thumbnail %>"
                    class="img-fluid w-100"
                    alt="<%= camp.title %>"
                    style="height: 250px; object-fit: cover;"
                    onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=900&q=80';"
                >

            </div>


            <!-- DETAILS -->

            <div class="col-md-8">

                <div class="card-body">

                    <h5 class="card-title">
                        <%= camp.title %>
                    </h5>

                    <p class="card-text">
                        <%= camp.description %>
                    </p>

                    <p class="card-text">
                        <small class="text-muted">
                            <%= camp.location %>
                        </small>
                    </p>

                    <a
                        href="/campgrounds/<%= camp._id %>"
                        class="btn btn-primary"
                    >
                        View
                    </a>

                </div>

            </div>

        </div>

    </div>

<% } %>


<!-- =========================
     MAP DATA
========================= -->

<%- "<script>" %>

const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";

const campgrounds = {
    type: "FeatureCollection",

    features: <%- JSON.stringify(
        campgrounds.map(campground => ({
            type: "Feature",
            geometry: campground.geometry,
            properties: {
                popUpMarkup:
                    campground?.properties?.popUpMarkup
            }
        }))
    ) %>
};

<%- "</script>" %>


<!-- =========================
     CLUSTER MAP JS
========================= -->

<script src="/javascripts/clusterMap.js"></script>