<% layout('layouts/boilerplate') %>

<h1>All Campgrounds</h1>

<div class="mb-3">
    <a href="/campgrounds/new" class="btn btn-success">
        Add New Campground
    </a>
</div>

<% for (let camp of campgrounds) { %>

    <div class="card mb-3">

        <div class="row">

            <div class="col-md-4">

                <img
                    src="<%= camp.image || 'https://placehold.co/800x500?text=No+Image' %>"
                    class="img-fluid"
                    alt="<%= camp.title %>"
                >

            </div>

            <div class="col-md-8">

                <div class="card-body">

                    <h5 class="card-title">
                        <%= camp.title %>
                    </h5>

                    <p class="card-text">
                        <%= camp.description %>
                    </p>

                    <p class="card-text">
                        <small class="text-muted">
                            <%= camp.location %>
                        </small>
                    </p>

                    <a
                        class="btn btn-primary"
                        href="/campgrounds/<%= camp._id %>"
                    >
                        View
                    </a>

                </div>

            </div>

        </div>

    </div>

<% } %>