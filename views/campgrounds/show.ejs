<% layout('layouts/boilerplate') %>

<div class="row">

    <div class="col-md-8 offset-md-2">

        <div class="card mb-3">

            <!-- Image -->
            <img
                src="<%= campground.image || 'https://placehold.co/800x500?text=No+Image' %>"
                class="card-img-top"
                alt="<%= campground.title %>"
            >

            <!-- Main Content -->
            <div class="card-body">

                <h5 class="card-title">
                    <%= campground.title %>
                </h5>

                <p class="card-text">
                    <%= campground.description %>
                </p>

            </div>

            <!-- Information -->
            <ul class="list-group list-group-flush">

                <li class="list-group-item">
                    <%= campground.location %>
                </li>

                <li class="list-group-item">
                    <strong>
                        $<%= campground.price %> / night
                    </strong>
                </li>

            </ul>

            <!-- Actions -->
            <div class="card-body">

                <a
                    href="/campgrounds/<%= campground._id %>/edit"
                    class="btn btn-primary"
                >
                    Edit
                </a>

                <form
                    action="/campgrounds/<%= campground._id %>?_method=DELETE"
                    method="POST"
                    class="d-inline"
                >
                    <button
                        type="submit"
                        class="btn btn-danger"
                    >
                        Delete
                    </button>
                </form>

                <a
                    href="/campgrounds"
                    class="btn btn-secondary"
                >
                    All Campgrounds
                </a>

            </div>

        </div>

    </div>

</div>