<% layout("layouts/boilerplate") %>

<link rel="stylesheet" href="/stylesheets/stars.css">

<div class="container py-4">

  <div class="row g-4">

    <!-- ================= CAMPGROUND ================= -->
    <div class="col-md-6">

      <div class="card shadow-sm">

        <!-- ================= IMAGE SLIDER ================= -->
        <% if (campground.images && campground.images.length > 0) { %>

          <div
            id="campgroundCarousel"
            class="carousel slide"
            data-bs-ride="carousel"
          >

            <div class="carousel-inner">

              <% campground.images.forEach((image, index) => { %>

                <div
                  class="carousel-item <%= index === 0 ? 'active' : '' %>"
                >
                  <img
                    src="<%= image.url %>"
                    class="d-block w-100"
                    alt="<%= campground.title %>"
                    style="height: 400px; object-fit: cover;"
                  >
                </div>

              <% }) %>

            </div>

            <!-- PREVIOUS BUTTON -->
            <% if (campground.images.length > 1) { %>

              <button
                class="carousel-control-prev"
                type="button"
                data-bs-target="#campgroundCarousel"
                data-bs-slide="prev"
              >
                <span class="carousel-control-prev-icon"></span>

                <span class="visually-hidden">
                  Previous
                </span>
              </button>

              <!-- NEXT BUTTON -->

              <button
                class="carousel-control-next"
                type="button"
                data-bs-target="#campgroundCarousel"
                data-bs-slide="next"
              >
                <span class="carousel-control-next-icon"></span>

                <span class="visually-hidden">
                  Next
                </span>
              </button>

            <% } %>

          </div>

        <% } else { %>

          <!-- NO IMAGE -->

          <img
            src="https://placehold.co/800x500?text=No+Image"
            class="card-img-top"
            alt="No image"
            style="height: 400px; object-fit: cover;"
          >

        <% } %>


        <!-- ================= CAMPGROUND DETAILS ================= -->

        <div class="card-body">

          <h2 class="card-title">
            <%= campground.title %>
          </h2>

          <p class="card-text">
            <%= campground.description %>
          </p>

          <p class="card-text">

            <strong>
              Submitted by:
            </strong>

            <%= campground.author
              ? campground.author.username
              : "Unknown" %>

          </p>

        </div>


        <!-- LOCATION + PRICE -->

        <ul class="list-group list-group-flush">

          <li class="list-group-item">
            📍 <%= campground.location %>
          </li>

          <li class="list-group-item">
            💰 $<%= campground.price %> / night
          </li>

        </ul>


        <!-- ================= ACTION BUTTONS ================= -->

        <div class="card-body">

          <% if (
            currentUser &&
            campground.author &&
            campground.author.equals(currentUser._id)
          ) { %>

            <a
              href="/campgrounds/<%= campground._id %>/edit"
              class="btn btn-primary"
            >
              Edit
            </a>

            <form
              action="/campgrounds/<%= campground._id %>?_method=DELETE"
              method="POST"
              class="d-inline"
            >
              <button
                type="submit"
                class="btn btn-danger"
              >
                Delete
              </button>
            </form>

          <% } %>


          <a
            href="/campgrounds"
            class="btn btn-secondary"
          >
            All Campgrounds
          </a>

        </div>

      </div>

    </div>


    <!-- ================= REVIEWS ================= -->

    <div class="col-md-6">
      <div id="map" style="width: 100%; height: 300px;"></div>


      <!-- ================= ADD REVIEW ================= -->

      <% if (currentUser) { %>

        <h2>
          Leave a Review
        </h2>

        <form
          action="/campgrounds/<%= campground._id %>/reviews"
          method="POST"
          class="mb-5"
        >

          <!-- ================= STAR RATING ================= -->

          <div class="mb-3">

            <label class="form-label">
              Rating
            </label>

            <fieldset class="starability-basic">

              <!-- 1 STAR -->

              <input
                type="radio"
                id="rate1"
                name="review[rating]"
                value="1"
                checked
              >

              <label
                for="rate1"
                title="Terrible"
              >
                1 star
              </label>


              <!-- 2 STARS -->

              <input
                type="radio"
                id="rate2"
                name="review[rating]"
                value="2"
              >

              <label
                for="rate2"
                title="Not good"
              >
                2 stars
              </label>


              <!-- 3 STARS -->

              <input
                type="radio"
                id="rate3"
                name="review[rating]"
                value="3"
              >

              <label
                for="rate3"
                title="Average"
              >
                3 stars
              </label>


              <!-- 4 STARS -->

              <input
                type="radio"
                id="rate4"
                name="review[rating]"
                value="4"
              >

              <label
                for="rate4"
                title="Very good"
              >
                4 stars
              </label>


              <!-- 5 STARS -->

              <input
                type="radio"
                id="rate5"
                name="review[rating]"
                value="5"
              >

              <label
                for="rate5"
                title="Amazing"
              >
                5 stars
              </label>

            </fieldset>

          </div>


          <!-- ================= REVIEW BODY ================= -->

          <div class="mb-3">

            <label
              class="form-label"
              for="body"
            >
              Review
            </label>

            <textarea
              class="form-control"
              id="body"
              name="review[body]"
              rows="5"
              required
            ></textarea>

          </div>


          <!-- ================= SUBMIT BUTTON ================= -->

          <button
            type="submit"
            class="btn btn-success"
          >
            Submit Review
          </button>

        </form>


      <% } else { %>

        <div class="alert alert-info">

          <a href="/login">
            Login
          </a>

          to leave a review.

        </div>

      <% } %>


      <!-- ================= SHOW REVIEWS ================= -->

      <h2>
        Reviews
      </h2>


      <% if (
        !campground.reviews ||
        campground.reviews.length === 0
      ) { %>

        <p class="text-muted">
          No reviews yet.
        </p>

      <% } %>


      <% campground.reviews.forEach(review => { %>

        <div class="card shadow-sm mb-3">

          <div class="card-body">


            <!-- ================= RATING ================= -->

            <h5 class="card-title">

              Rating:

              <span class="text-warning">

                <% for (let i = 0; i < review.rating; i++) { %>
                  ★
                <% } %>

              </span>

            </h5>


            <!-- ================= AUTHOR ================= -->

            <p class="text-muted mb-2">

              <strong>
                Reviewed by:
              </strong>

              <%= review.author
                ? review.author.username
                : "Anonymous" %>

            </p>


            <!-- ================= REVIEW BODY ================= -->

            <p class="card-text">
              <%= review.body %>
            </p>


            <!-- ================= DELETE REVIEW ================= -->

            <% if (
              currentUser &&
              review.author &&
              review.author.equals(currentUser._id)
            ) { %>

              <form
                action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="POST"
              >

                <button
                  type="submit"
                  class="btn btn-sm btn-danger"
                >
                  Delete
                </button>

              </form>

            <% } %>

          </div>

        </div>

      <% }) %>

    </div>

  </div>

</div>

maptilersdk.config.apiKey = maptilerApiKey;

const map = new maptilersdk.Map({
    container: 'map',
    style: maptilersdk.MapStyle.BRIGHT,
    center: campground.geometry.coordinates, // starting position [lng, lat]
    zoom: 10 // starting zoom
});

<%-"<script>"%>
const maptilerApiKey = '<%- process.env.MAPTILER_API_KEY %>';
const campground = <%- JSON.stringify(campground) %>;
<%-"</script>"%>

<script src="/javascripts/showPageMap.js"></script>