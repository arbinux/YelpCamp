<% layout("layouts/boilerplate") %>

<div class="container-fluid px-0">

    <!-- ================= HERO ================= -->

    <section class="home-hero">

        <div class="home-overlay">

            <div class="container text-center text-white">

                <h1 class="display-3 fw-bold">
                    Welcome to YelpCamp
                </h1>

                <p class="lead mt-3">
                    Discover amazing campgrounds and share
                    your outdoor adventures.
                </p>

                <div class="mt-4">

                    <a
                        href="/campgrounds"
                        class="btn btn-light btn-lg me-2"
                    >
                        Explore Campgrounds
                    </a>

                    <% if (!currentUser) { %>

                        <a
                            href="/register"
                            class="btn btn-outline-light btn-lg"
                        >
                            Join YelpCamp
                        </a>

                    <% } %>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= FEATURES ================= -->

    <section class="container py-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Everything You Need for Your Next Adventure
            </h2>

            <p class="text-muted">
                Find places, share experiences, and discover new destinations.
            </p>

        </div>


        <div class="row g-4">

            <!-- FEATURE 1 -->

            <div class="col-md-4">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center p-4">

                        <div class="fs-1 mb-3">
                            🏕️
                        </div>

                        <h4 class="fw-bold">
                            Discover Campgrounds
                        </h4>

                        <p class="text-muted">
                            Explore campgrounds from different locations
                            and find the perfect place for your next trip.
                        </p>

                        <a
                            href="/campgrounds"
                            class="btn btn-primary"
                        >
                            Browse Campgrounds
                        </a>

                    </div>

                </div>

            </div>


            <!-- FEATURE 2 -->

            <div class="col-md-4">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center p-4">

                        <div class="fs-1 mb-3">
                            📍
                        </div>

                        <h4 class="fw-bold">
                            Find Locations
                        </h4>

                        <p class="text-muted">
                            Use the interactive map to discover campground
                            locations and plan your adventure.
                        </p>

                        <a
                            href="/campgrounds"
                            class="btn btn-primary"
                        >
                            Explore Map
                        </a>

                    </div>

                </div>

            </div>


            <!-- FEATURE 3 -->

            <div class="col-md-4">

                <div class="card h-100 shadow-sm border-0">

                    <div class="card-body text-center p-4">

                        <div class="fs-1 mb-3">
                            ⭐
                        </div>

                        <h4 class="fw-bold">
                            Share Your Experience
                        </h4>

                        <p class="text-muted">
                            Add your own campground and share reviews
                            with the YelpCamp community.
                        </p>

                        <% if (currentUser) { %>

                            <a
                                href="/campgrounds/new"
                                class="btn btn-primary"
                            >
                                Add Campground
                            </a>

                        <% } else { %>

                            <a
                                href="/login"
                                class="btn btn-primary"
                            >
                                Login to Contribute
                            </a>

                        <% } %>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= CTA ================= -->

    <section class="bg-light py-5">

        <div class="container text-center">

            <h2 class="fw-bold">
                Ready to Explore?
            </h2>

            <p class="text-muted mb-4">
                Start discovering beautiful campgrounds today.
            </p>

            <a
                href="/campgrounds"
                class="btn btn-dark btn-lg"
            >
                View All Campgrounds
            </a>

        </div>

    </section>

</div>